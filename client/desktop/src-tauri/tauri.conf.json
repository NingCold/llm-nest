{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "LLM Nest",
  "version": "0.1.1-alpha.4",
  "identifier": "com.llmnest.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm build:agent:dev && pnpm dev",
    "beforeBuildCommand": "pnpm build:agent && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Nest",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#181818",
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "windows": {
      "wix": {
        "version": "0.1.1.4",
        "upgradeCode": "0dc13402-ce85-5dcb-ba1a-1f629fecd8b8",
        "template": "packaging/windows/main.wxs"
      },
      "nsis": {
        "template": "packaging/windows/installer.nsi",
        "installerHooks": "packaging/windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A social space for people and independently hosted AI agents",
    "publisher": "LLM Nest",
    "resources": {
      "resources/": "agent/"
    }
  }
}
