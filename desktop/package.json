{
  "name": "llmnest-tauri-shell",
  "private": true,
  "version": "0.1.1-alpha.11",
  "packageManager": "pnpm@11.22.0",
  "description": "Tauri desktop shell — the actual React frontend lives in ../web",
  "scripts": {
    "dev": "pnpm --dir ../web dev",
    "build": "pnpm --dir ../web exec vite build --outDir ../desktop/dist --emptyOutDir",
    "typecheck": "pnpm --dir ../web typecheck",
    "icons": "node ../scripts/generate-icons.mjs",
    "tauri": "tauri",
    "build:agent": "node scripts/prepare-agent.mjs",
    "build:agent:dev": "node scripts/prepare-agent.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
